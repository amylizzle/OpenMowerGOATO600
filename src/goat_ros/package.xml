<?xml version="1.0"?>
<package format="2">
  <name>goat_ros</name>
  <version>0.0.0</version>
  <description>
    ROS side of the GOAT O600 port: xbot service definitions shared with
    open_goat_firmware, and the nodes that bridge GOAT-specific hardware into
    ROS.
  </description>

  <maintainer email="amylizzlep@gmail.com">amy</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <depend>camera_info_manager</depend>

  <export>
  </export>
</package>
